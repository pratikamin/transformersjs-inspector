{
  "name": "transformersjs-inspector",
  "version": "0.3.0",
  "description": "A Network-tab-style inspector for Transformers.js pipelines: sessions, tokenizer, per-step logits, results.",
  "license": "MIT",
  "author": "Pratik Amin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratikamin/transformersjs-inspector.git"
  },
  "homepage": "https://github.com/pratikamin/transformersjs-inspector#readme",
  "bugs": {
    "url": "https://github.com/pratikamin/transformersjs-inspector/issues"
  },
  "keywords": [
    "transformers.js",
    "transformersjs",
    "huggingface",
    "onnxruntime-web",
    "onnx",
    "inspector",
    "devtools",
    "debugging",
    "logits",
    "tokenizer",
    "webgpu",
    "wasm",
    "browser",
    "machine-learning"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/preload.js",
    "./src/preload.ts",
    "./demo/preload-entry.ts"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:demo": "vite build --config vite.demo.config.ts",
    "e2e": "playwright test --project=chromium",
    "screenshots": "playwright test --project=screenshots"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=4 <5"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@huggingface/transformers": "4.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "happy-dom": "20.14.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
